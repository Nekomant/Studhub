# Шаблон .env для prod. На сервере: cp .env.prod.example .env && chmod 600 .env
# Значения подставляет владелец на сервере. В репозиторий настоящие секреты не попадают.

# Базовый домен. app.<DOMAIN> обслуживает SPA, API и iCal.
DOMAIN=studshub.ru

# Адрес для уведомлений Let's Encrypt о сертификатах.
ACME_EMAIL=

# Postgres: пароль длиной от 32 символов (например, `openssl rand -hex 24`).
POSTGRES_USER=studhub
POSTGRES_PASSWORD=
POSTGRES_DB=studhub

# S3 для файлов. Приложение не стартует без этих пяти значений. Пока S3 не подключён, укажи заглушки (см. infra/README.md).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Тег образа приложения. deploy.sh записывает сюда тег после каждой успешной выкладки.
APP_TAG=latest
