{
  "name": "@studhub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "gen:openapi": "node src/gen-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "^0.29.21",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
