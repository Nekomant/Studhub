{
  "openapi": "3.1.0",
  "info": {
    "title": "StudentsHub API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "responses": {
          "200": {
            "description": "Сервис работает, БД доступна",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    },
                    "db": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  },
                  "required": ["status", "db"]
                }
              }
            }
          },
          "503": {
            "description": "БД недоступна",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "code": {
                      "type": "string"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": ["path", "message"]
                      }
                    }
                  },
                  "required": ["type", "title", "status", "code"]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
