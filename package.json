{
  "name": "studhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "postinstall": "node scripts/setup-git.mjs",
    "check": "biome ci . && tsc -b",
    "gen:openapi": "pnpm --filter @studhub/api gen:openapi",
    "gen:client": "node packages/client-core/scripts/gen-client.mjs",
    "gen:client:check": "node packages/client-core/scripts/gen-client.mjs --check",
    "test": "vitest run",
    "test:api": "vitest run --project @studhub/tests-api",
    "verify": "node scripts/verify.mjs",
    "format": "biome check --write .",
    "db:check": "pnpm --filter @studhub/api db:check",
    "ac:check": "node scripts/check-ac-coverage.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset-test": "node --env-file-if-exists=.env scripts/db-reset-test.mjs",
    "git:prune": "node scripts/git-prune.mjs",
    "sync": "node scripts/sync.mjs",
    "close-task": "node scripts/close-task.mjs",
    "status": "node scripts/status.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
