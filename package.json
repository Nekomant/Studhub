{
  "name": "studhub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "biome ci . && tsc -b",
    "gen:openapi": "pnpm --filter @studhub/api gen:openapi",
    "test": "vitest run",
    "format": "biome check --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset-test": "node --env-file-if-exists=.env scripts/db-reset-test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  }
}
