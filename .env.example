# Шаблон переменных окружения. Скопируйте в `.env` и при необходимости поправьте:
#   cp .env.example .env
# Значения ниже — только для локальной разработки. В prod секреты задаются на сервере.

# Режим работы приложения: development, test или production.
NODE_ENV=development

# Режим приложения: test включает тестовые маршруты (/__test/clock) для API-тестов. В dev и prod оставьте пустым.
APP_MODE=

# Адрес dev-БД Postgres 18 (сервис postgres из docker-compose.yml).
DATABASE_URL=postgres://studhub:change-me-local@localhost:5432/studhub

# Отдельная БД для API-тестов. Её пересоздаёт `pnpm db:reset-test`, dev-БД не трогается. Имя должно оканчиваться на _test.
TEST_DATABASE_URL=postgres://studhub:change-me-local@localhost:5432/studhub_test

# Адрес S3 API. Локально это Garage на порту 3900.
S3_ENDPOINT=http://localhost:3900

# Регион S3. Garage принимает только garage (так задано в infra/garage/garage.toml).
S3_REGION=garage

# Имя бакета для файлов. Garage создаёт его при старте.
S3_BUCKET=studhub-files

# Ключ доступа к S3. Garage требует формат GK и 24 шестнадцатеричных символа. Значение только для локальной работы.
S3_ACCESS_KEY_ID=GKc0ffee000000000000000000

# Секретный ключ S3: 64 шестнадцатеричных символа. Значение только для локальной работы.
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Переменные docker compose (не читаются приложением): пользователь и пароль Postgres.
POSTGRES_USER=studhub
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=studhub
# Порт Postgres на хосте.
POSTGRES_PORT=5432

# Переменные docker compose: секрет RPC Garage (64 шестнадцатеричных символа) и порт S3 API на хосте.
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S3_PORT=3900
